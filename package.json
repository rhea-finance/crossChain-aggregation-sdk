{
  "name": "@rhea-finance/cross-chain-aggregation-dex",
  "version": "0.1.0",
  "description": "TypeScript SDK for cross-chain DEX aggregation and routing on NEAR. Supports multi-DEX routing, automatic token registration, pre-swap handling, and NearIntents bridge integration for seamless cross-chain token swaps.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "defi",
    "dex",
    "aggregator",
    "router",
    "swap",
    "cross-chain",
    "near",
    "multi-chain",
    "rhea-finance"
  ],
  "author": "Rhea Finance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhea-finance/crossChain-aggregation-sdk.git"
  },
  "dependencies": {
    "big.js": "^6.1.1"
  },
  "devDependencies": {
    "@types/big.js": "^6.1.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@near-js/providers": "*"
  },
  "peerDependenciesMeta": {
    "@near-js/providers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

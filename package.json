{
  "name": "@rhea-finance/cross-chain-aggregation-dex",
  "version": "1.0.0",
  "description": "TypeScript SDK for a unified multi-chain Swap API with quote, transaction building, execution adapters, status, reporting, and history.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./executors/evm": {
      "types": "./dist/executors/evm.d.ts",
      "import": "./dist/executors/evm.mjs",
      "require": "./dist/executors/evm.js"
    },
    "./executors/solana": {
      "types": "./dist/executors/solana.d.ts",
      "import": "./dist/executors/solana.mjs",
      "require": "./dist/executors/solana.js"
    },
    "./executors/aptos": {
      "types": "./dist/executors/aptos.d.ts",
      "import": "./dist/executors/aptos.mjs",
      "require": "./dist/executors/aptos.js"
    },
    "./executors/near": {
      "types": "./dist/executors/near.d.ts",
      "import": "./dist/executors/near.mjs",
      "require": "./dist/executors/near.js"
    },
    "./executors/tron": {
      "types": "./dist/executors/tron.d.ts",
      "import": "./dist/executors/tron.mjs",
      "require": "./dist/executors/tron.js"
    },
    "./executors/bitcoin": {
      "types": "./dist/executors/bitcoin.d.ts",
      "import": "./dist/executors/bitcoin.mjs",
      "require": "./dist/executors/bitcoin.js"
    },
    "./executors/zcash": {
      "types": "./dist/executors/zcash.d.ts",
      "import": "./dist/executors/zcash.mjs",
      "require": "./dist/executors/zcash.js"
    },
    "./executors/sui": {
      "types": "./dist/executors/sui.d.ts",
      "import": "./dist/executors/sui.mjs",
      "require": "./dist/executors/sui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "prepublishOnly": "pnpm test && pnpm type-check && pnpm build"
  },
  "keywords": [
    "defi",
    "dex",
    "aggregator",
    "router",
    "swap",
    "cross-chain",
    "near",
    "multi-chain",
    "rhea-finance"
  ],
  "author": "Rhea Finance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhea-finance/crossChain-aggregation-sdk.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
